Subject: [PATCH] Fix partners marquee: interleave platform logos and artist
 photos so one platform then one artist alternates, no clustering

---
 src/lib/partners/partners.config.ts | 22 +++++++++++++++++++---
 1 file changed, 19 insertions(+), 3 deletions(-)

diff --git a/src/lib/partners/partners.config.ts b/src/lib/partners/partners.config.ts
index d0b4b3e..d997a31 100644
--- a/src/lib/partners/partners.config.ts
+++ b/src/lib/partners/partners.config.ts
@@ -2,8 +2,9 @@
 /**
  * Partner roster for the "As seen with" / supporting-partners marquee.
  *
- * Uses real partner assets from public/images/platforms/.
- * These are the actual company logos shipped with the repo.
+ * Uses real assets from both public/images/platforms/ (companies) and
+ * public/images/artists/ (people). The list is interleaved so one platform
+ * and one artist alternate — no clustering, natural variety across the strip.
  */
 
 export interface PartnerSlot {
@@ -13,16 +14,31 @@ export interface PartnerSlot {
   href?: string;
 }
 
